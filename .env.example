# Required: the bot's token from https://discord.com/developers/applications
MARKET_DISCORD_TOKEN=
# Optional: where it keeps price history, models, channel settings and its track record
MARKET_DATA_DIR=market-data
# Optional: seconds between live board updates (default 60, minimum 30)
LIVE_INTERVAL=
# Optional: an AI reads the important headlines too. Free: a Groq key (console.groq.com) or a Gemini key
# (aistudio.google.com); paid: an Anthropic key for Claude. Set any of them; with several, the first one
# that's free to answer reads each batch.
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: a Massive (formerly Polygon.io) key for the NVIDIA channel. Used for NVIDIA only, at most 5 calls a
# minute (the free plan's limit). POLYGON_API_KEY works too.
MASSIVE_API_KEY=
# Optional: send Yahoo Finance requests through a proxy (e.g. http://user:pass@host:port) if Yahoo blocks your
# host's IP address. Everything else goes direct.
YAHOO_PROXY=
# Optional: guild ID to sync slash commands to instantly while developing
DEV_GUILD_ID=
