# Required: bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Optional: seconds between score checks (default 10, minimum 5)
POLL_INTERVAL=
# Optional: where channel subscriptions are stored
DATA_FILE=subscriptions.json
# Optional: guild ID to sync slash commands to instantly while developing
DEV_GUILD_ID=

# ----- Market bot (python -m marketbot; see MARKETBOT.md) -----
# Required: the market bot's own token (a separate Discord application)
MARKET_DISCORD_TOKEN=
# Optional: where it keeps price history, models, channel settings and its track record
MARKET_DATA_DIR=market-data
# Optional: seconds between live board updates (default 60, minimum 30)
LIVE_INTERVAL=
# Optional: lets Claude read the important headlines too
ANTHROPIC_API_KEY=
